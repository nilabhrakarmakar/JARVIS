<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>J.A.R.V.I.S. | Stable Edition</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <style>
        :root { --bg-color: #131314; --surface-color: #1e1f20; --text-primary: #e3e3e3; --text-secondary: #c4c7c5; --accent: #a8c7fa; }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background-color: var(--bg-color); color: var(--text-primary); font-family: 'Outfit', sans-serif; height: 100vh; display: flex; flex-direction: column; }
        
        .navbar { padding: 15px 25px; display: flex; justify-content: space-between; align-items: center; font-size: 1.4rem; color: var(--text-secondary); }
        .navbar-brand { display: flex; align-items: center; }
        .navbar-brand span { margin-right: 10px; color: var(--accent); }
        .sys-stats { font-size: 0.85rem; display: flex; align-items: center; gap: 15px; background: var(--surface-color); padding: 8px 15px; border-radius: 20px;}
        .sys-stats span { color: var(--accent); font-weight: 500;}
        select { background: transparent; color: var(--accent); border: 1px solid var(--accent); padding: 3px 5px; border-radius: 5px; outline: none; font-family: 'Outfit'; max-width: 150px;}

        .main-container { flex: 1; display: flex; flex-direction: column; align-items: center; overflow-y: auto; padding: 20px; scroll-behavior: smooth; }
        
        .welcome-screen { max-width: 800px; width: 100%; margin-top: 5vh; animation: fadeIn 0.5s ease-in; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        
        .greeting { font-size: 3.5rem; font-weight: 500; margin-bottom: 40px; background: -webkit-linear-gradient(45deg, #4b90ff, #ff5546); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

        .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 15px; margin-bottom: 40px; }
        .card { background-color: var(--surface-color); padding: 20px; border-radius: 15px; cursor: pointer; transition: 0.3s; height: 120px; display: flex; flex-direction: column; justify-content: space-between; }
        .card:hover { background-color: #333537; }
        .card span.icon { align-self: flex-end; background: #131314; padding: 8px; border-radius: 50%; font-size: 1.2rem; }

        #chatbox { width: 100%; max-width: 800px; display: flex; flex-direction: column; gap: 25px; padding-bottom: 20px; }
        .chat-row { display: flex; gap: 15px; max-width: 100%; }
        .user-row { flex-direction: row-reverse; }
        .avatar { width: 35px; height: 35px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--surface-color); color: var(--accent); flex-shrink: 0; }
        .msg-bubble { max-width: 80%; line-height: 1.6; font-size: 1.05rem; }
        .user-bubble { background-color: var(--surface-color); padding: 12px 20px; border-radius: 20px 5px 20px 20px; }

        .input-container { width: 100%; max-width: 800px; margin: 0 auto; padding: 0 20px 20px 20px; }
        .file-indicator { font-size: 0.85rem; color: var(--accent); margin-bottom: 5px; display: none; padding-left: 15px;}
        .search-box { display: flex; align-items: center; background-color: var(--surface-color); border-radius: 30px; padding: 5px 10px; }
        .search-box input[type="text"] { flex: 1; background: transparent; border: none; color: #fff; padding: 15px; font-size: 1.1rem; font-family: 'Outfit'; outline: none; }
        .icon-btn { background: transparent; border: none; color: var(--text-secondary); cursor: pointer; padding: 10px; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: 0.2s; }
        .icon-btn:hover { background: rgba(255,255,255,0.1); color: var(--text-primary); }
        .mic-active { color: #ff5546 !important; animation: pulse 1s infinite; }
        .wake-active { color: #4b90ff !important; animation: pulse 1.5s infinite; }
        @keyframes pulse { 0% { transform: scale(1); } 50% { transform: scale(1.1); } 100% { transform: scale(1); } }
    </style>
</head>
<body>

    <div class="navbar">
        <div class="navbar-brand">
            <span class="material-symbols-outlined">temp_preferences_custom</span>
            J.A.R.V.I.S.
        </div>
        <div class="sys-stats">
            <div>CPU: <span id="cpu-val">--</span></div>
            <div>RAM: <span id="ram-val">--</span></div>
            <select id="voiceSelect" title="Select J.A.R.V.I.S. Voice"></select>
        </div>
    </div>

    <div class="main-container" id="main-scroll">
        <div class="welcome-screen" id="welcome-screen">
            <div class="greeting">Hello, Nilabhra</div>
            <h2 style="color: var(--text-secondary); font-weight: 400; margin-bottom: 30px;">How can I help you today?</h2>
            
            <div class="card-grid">
                <div class="card" onclick="setPrompt('Write a Python script to automate file organization')">
                    <p>Write a Python script to automate file organization</p>
                    <span class="material-symbols-outlined icon">terminal</span>
                </div>
                <div class="card" onclick="setPrompt('Analyze this image I attached')">
                    <p>Analyze this image I attached</p>
                    <span class="material-symbols-outlined icon">image</span>
                </div>
                <div class="card" onclick="setPrompt('Explain Cloud Computing basics')">
                    <p>Explain Cloud Computing basics</p>
                    <span class="material-symbols-outlined icon">cloud</span>
                </div>
                <div class="card" onclick="setPrompt('Remember that my exams are next month')">
                    <p>Remember that my exams are next month</p>
                    <span class="material-symbols-outlined icon">memory</span>
                </div>
            </div>
        </div>
        <div id="chatbox"></div>
    </div>

    <div class="input-container">
        <div class="file-indicator" id="fileIndicator">📎 File attached: <span></span></div>
        <div class="search-box">
            <input type="file" id="fileInput" style="display: none;" onchange="updateFileIndicator()" accept=".pdf,.txt,.c,.py,.md,.png,.jpg,.jpeg">
            
            <button class="icon-btn" onclick="document.getElementById('fileInput').click()" title="Attach File or Image">
                <span class="material-symbols-outlined">attach_file</span>
            </button>

            <input type="text" id="userInput" placeholder="Ask J.A.R.V.I.S. anything..." onkeypress="if(event.key==='Enter') sendMessage()">
            
            <button class="icon-btn" id="wakeBtn" onclick="toggleWakeWord()" title="Enable Auto Wake-Word (Say 'Jarvis')">
                <span class="material-symbols-outlined">hearing</span>
            </button>

            <button class="icon-btn" onclick="stopAudio()" title="Stop Speaking">
                <span class="material-symbols-outlined" style="color: #ff5546;">volume_off</span>
            </button>
            <button class="icon-btn" id="micBtn" onclick="toggleMic()" title="Toggle Mic">
                <span class="material-symbols-outlined">mic</span>
            </button>
            <button class="icon-btn" onclick="sendMessage()" title="Send Message">
                <span class="material-symbols-outlined" style="color: var(--accent);">send</span>
            </button>
        </div>
    </div>

<script>
    // System Stats Fetcher
    setInterval(() => {
        fetch('/stats').then(res => res.json()).then(data => {
            document.getElementById('cpu-val').innerText = data.cpu + '%';
            document.getElementById('ram-val').innerText = data.ram + '%';
        }).catch(err => console.log(err));
    }, 2000);

    // 🌟 AUTO HINDI VOICE LOGIC 🌟
    let availableVoices = [];
    function loadVoices() {
        availableVoices = window.speechSynthesis.getVoices();
        const vs = document.getElementById('voiceSelect');
        vs.innerHTML = availableVoices.map((v, i) => `<option value="${i}">${v.name}</option>`).join('');
        
        // Google Hindi ya Microsoft Hindi ko auto-select karna
        let hindiVoiceIndex = availableVoices.findIndex(v => 
            v.name.includes('Google हिन्दी') || 
            v.lang === 'hi-IN' || 
            v.name.includes('Hindi')
        );

        if (hindiVoiceIndex !== -1) {
            vs.value = hindiVoiceIndex;
        }
    }
    window.speechSynthesis.onvoiceschanged = loadVoices;
    loadVoices();

    function stopAudio() { window.speechSynthesis.cancel(); }

    // Wake Word Background Listener
    let wakeWordEnabled = false;
    const wakeRecognition = new (window.SpeechRecognition || window.webkitSpeechRecognition)();
    wakeRecognition.lang = 'en-US'; 
    wakeRecognition.continuous = true;
    wakeRecognition.interimResults = false;

    function toggleWakeWord() {
        const btn = document.getElementById('wakeBtn');
        wakeWordEnabled = !wakeWordEnabled;
        if(wakeWordEnabled) {
            btn.classList.add("wake-active");
            document.getElementById('userInput').placeholder = "Wake Word ON. Say 'Jarvis'...";
            try { wakeRecognition.start(); } catch(e){}
        } else {
            btn.classList.remove("wake-active");
            wakeRecognition.stop();
            document.getElementById('userInput').placeholder = "Ask J.A.R.V.I.S. anything...";
        }
    }

    wakeRecognition.onresult = (e) => {
        let transcript = e.results[e.results.length - 1][0].transcript.toLowerCase();
        if (transcript.includes("jarvis") || transcript.includes("wake up")) {
            wakeRecognition.stop(); 
            const speech = new SpeechSynthesisUtterance("Yes Sir?");
            const voiceIdx = document.getElementById('voiceSelect').value;
            if (voiceIdx !== '') speech.voice = availableVoices[voiceIdx];
            speech.onend = function() { toggleMic(); };
            window.speechSynthesis.speak(speech);
        }
    };

    wakeRecognition.onend = () => {
        if (wakeWordEnabled && !isMicOn) { try { wakeRecognition.start(); } catch(e){} }
    };

    // Main Mic Listener
    const recognition = new (window.SpeechRecognition || window.webkitSpeechRecognition)();
    recognition.lang = 'hi-IN'; recognition.interimResults = true; recognition.continuous = true;
    let isMicOn = false; let silenceTimer;

    function toggleMic() {
        const btn = document.getElementById('micBtn');
        isMicOn = !isMicOn;
        if(isMicOn) { 
            if(wakeWordEnabled) wakeRecognition.stop(); 
            btn.classList.add("mic-active"); 
            document.getElementById('userInput').placeholder = "Listening to your command...";
            recognition.start(); 
        } else { 
            btn.classList.remove("mic-active"); 
            document.getElementById('userInput').placeholder = wakeWordEnabled ? "Wake Word ON. Say 'Jarvis'..." : "Ask J.A.R.V.I.S. anything...";
            recognition.stop(); 
            if(wakeWordEnabled) { try { wakeRecognition.start(); } catch(e){} }
        }
    }

    recognition.onresult = (e) => {
        let transcript = Array.from(e.results).map(r => r[0].transcript).join('');
        document.getElementById('userInput').value = transcript;
        if (isMicOn) {
            clearTimeout(silenceTimer);
            silenceTimer = setTimeout(() => { if(transcript.trim()) { toggleMic(); sendMessage(); } }, 3500);
        }
    };

    function setPrompt(text) {
        document.getElementById('userInput').value = text;
        sendMessage();
    }

    // TypeWriter Effect
    function typeWriter(text, element) {
        let i = 0;
        function type() {
            if (i < text.length) {
                element.innerHTML += text.charAt(i) === '\n' ? '<br>' : text.charAt(i);
                i++;
                const mainScroll = document.getElementById('main-scroll');
                mainScroll.scrollTop = mainScroll.scrollHeight;
                setTimeout(type, 15);
            }
        }
        type();
    }

    function updateFileIndicator() {
        const fileInput = document.getElementById('fileInput');
        const indicator = document.getElementById('fileIndicator');
        if (fileInput.files.length > 0) {
            indicator.style.display = 'block';
            indicator.querySelector('span').innerText = fileInput.files[0].name;
        } else {
            indicator.style.display = 'none';
        }
    }

    // Main Send Message Function
    async function sendMessage() {
        const input = document.getElementById('userInput');
        const fileInput = document.getElementById('fileInput');
        const text = input.value; 
        const file = fileInput.files[0];
        
        if (!text && !file) return;

        window.speechSynthesis.cancel();
        document.getElementById('welcome-screen').style.display = 'none';

        const chatbox = document.getElementById('chatbox');
        
        let userDisplayMsg = text;
        if (file) {
            userDisplayMsg = `📎 [Attached: ${file.name}]<br>` + text;
        }

        chatbox.innerHTML += `
            <div class="chat-row user-row">
                <div class="avatar"><span class="material-symbols-outlined">person</span></div>
                <div class="msg-bubble user-bubble">${userDisplayMsg}</div>
            </div>`;
        
        input.value = '';
        fileInput.value = '';
        updateFileIndicator();
        
        const msgId = 'ai-' + Date.now();
        chatbox.innerHTML += `
            <div class="chat-row ai-row">
                <div class="avatar"><span class="material-symbols-outlined">temp_preferences_custom</span></div>
                <div class="msg-bubble ai-bubble" id="${msgId}">
                    <span class="material-symbols-outlined" style="animation: pulse 1s infinite; opacity:0.5;">more_horiz</span>
                </div>
            </div>`;
            
        const mainScroll = document.getElementById('main-scroll');
        mainScroll.scrollTop = mainScroll.scrollHeight;

        try {
            const formData = new FormData();
            formData.append('message', text);
            if (file) formData.append('file', file);

            const res = await fetch('/chat', { method: 'POST', body: formData });
            const data = await res.json();
            
            const replyContainer = document.getElementById(msgId);
            replyContainer.innerHTML = ''; 
            
            typeWriter(data.reply, replyContainer);

            const cleanText = data.reply.replace(/[*#_`]/g, ''); 
            const speech = new SpeechSynthesisUtterance(cleanText);
            
            const voiceIdx = document.getElementById('voiceSelect').value;
            if (voiceIdx !== '') speech.voice = availableVoices[voiceIdx];
            
            speech.onend = function() {
                if (isMicOn) { 
                    try { recognition.start(); } catch (e) {} 
                } else if (wakeWordEnabled) {
                    try { wakeRecognition.start(); } catch (e) {}
                }
            };
            window.speechSynthesis.speak(speech);

        } catch (e) { 
            document.getElementById(msgId).innerText = "Connection Error. Please check terminal."; 
        }
    }
</script>
</body>
</html>
